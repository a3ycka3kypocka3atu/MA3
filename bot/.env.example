BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated immutable numeric Telegram user IDs that receive admin access.
# There are no default admins.
ADMIN_TELEGRAM_USER_IDS=123456789,987654321

# Explicit numeric Telegram user ID to Platum workspace-key assignments.
# Unassigned users are denied cabinet access. Telegram usernames are never used for access.
TELEGRAM_WORKSPACE_ASSIGNMENTS=555555555:client_alpha,666666666:client_beta

# Comma-separated numeric Telegram chat IDs used only for inquiry notifications.
# This variable never grants admin or cabinet access.
ADMIN_CHAT_IDS=123456789,987654321

# Must also be allowed in Supabase Auth > URL Configuration.
CABINET_URL=https://client-cabinet.vercel.app
