# Platum Supabase tooling values. Copy this file to .env and populate it only
# from the Supabase project assigned to Platum.
SUPABASE_PROJECT_REF=your_platum_project_ref
SUPABASE_URL=https://your-platum-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_platum_key

# Never put a service-role or secret key in browser code. The optional Telegram
# worker has a separate server-only template at bot/.env.example.
